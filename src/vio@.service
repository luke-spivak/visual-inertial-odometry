# Native runtime; install the release and its configuration before this unit.
[Unit]
Description=Native VIO application for %i

[Service]
Environment=SUDO_USER=%i
Group=%i
UMask=0002
ExecStart=/home/%i/vio-native/vio_flight /home/%i/vio-native/config/flight.json
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
