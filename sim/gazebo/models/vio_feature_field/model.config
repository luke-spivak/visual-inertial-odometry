<?xml version="1.0"?>
<model>
  <name>vio_feature_field</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Scattered static boxes, cylinders and spheres of varied height, giving the
    scene depth structure the flat runway does not have. Regenerate with
    gazebo/worlds/make_feature_field.py; model.sdf is generated, not hand-written.
  </description>
</model>
