<?xml version="1.0" ?>
<!-- render_probe.sdf: lighting/material diagnostic, no vehicle, no SITL.
     The origin is kept clear for the takeoff pad, so the low camera sees it
     rather than a calibration box; the patches sit at y=6.
     A static camera 15 m up looking down at both kinds of surface:
       * the runway/airfield, whose appearance comes from PBR albedo MAPS
       * the feature field, whose appearance comes from plain material COLOURS
       * three calibration boxes with known albedo (0.05 / 0.50 / 0.95)
     If the calibration boxes come out at roughly 13, 128 and 242 the renderer
     is fine and the fault is in texture loading. If they all come out near 13,
     lighting or shading is broken and textures are a red herring.

     gz sim -s -r -v4 render_probe.sdf   (starts in ~5 s, unlike the full world) -->
<sdf version="1.9">
  <world name="iris_runway">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <headless_rendering>false</headless_rendering>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://runway</uri>
      <pose degrees="true">-29 545 0 0 0 363</pose>
    </include>

    <include>
      <uri>model://vio_ground</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://vio_feature_field</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Known-albedo reference patches, 4 m square, laid flat under the camera. -->
    <model name="greyscale_ramp">
      <static>true</static>
      <link name="link">
        <visual name="dark">
          <pose>-5 6 0.05 0 0 0</pose>
          <geometry><box><size>4 4 0.1</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
        <visual name="mid">
          <pose>0 6 0.05 0 0 0</pose>
          <geometry><box><size>4 4 0.1</size></box></geometry>
          <material>
            <ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse>
          </material>
        </visual>
        <!-- Same 0.95 albedo, but delivered as a PBR albedo MAP instead of a
             colour. This is the one variable that separates the calibration
             patches (which render correctly) from the runway and airfield
             (which render black). -->
        <visual name="textured">
          <pose>0 10 0.05 0 0 0</pose>
          <geometry><box><size>4 4 0.1</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://runway/materials/textures/runway.png</albedo_map>
                <roughness>0.6</roughness>
                <metalness>0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <visual name="light">
          <pose>5 6 0.05 0 0 0</pose>
          <geometry><box><size>4 4 0.1</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Second camera at the vehicle's resting camera height, 0.215 m. The
         static initialiser only ever sees this view, so it is the one that
         decides whether OpenVINS can initialise at all. -->
    <model name="probe_cam_low">
      <static>true</static>
      <pose>0 0 0.215 0 0 0</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <pose>0 0 0 0 1.5707963 0</pose>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>probe/image_low</topic>
          <camera>
            <horizontal_fov>1.3963</horizontal_fov>
            <image><width>640</width><height>400</height><format>L8</format></image>
            <clip><near>0.05</near><far>500</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="probe_cam">
      <static>true</static>
      <pose>0 0 15 0 0 0</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <!-- Same downward convention as vio_camera: +90 deg about Y puts the
               gz optical axis (+X) along link -Z. -->
          <pose>0 0 0 0 1.5707963 0</pose>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>probe/image</topic>
          <camera>
            <horizontal_fov>1.3963</horizontal_fov>
            <image><width>640</width><height>400</height><format>L8</format></image>
            <clip><near>0.05</near><far>500</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
