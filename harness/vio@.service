# vio@.service -- harness/vio_flight.py from boot, as root, for the user named
# after the @ (whose ~/harness, ~/vio_live and ~/vio it uses). Install and use:
# see vio_flight.py.
[Unit]
Description=VIO flight session for %i (harness/vio_flight.py)

[Service]
Environment=SUDO_USER=%i
ExecStart=/usr/bin/python3 -u /home/%i/harness/vio_flight.py
# SIGTERM to vio_flight.py alone: it passes it to vio_live.py, which stops the
# camera and lets vio_live close the recording. Anything left is killed only if
# that overruns TimeoutStopSec (vio_flight.py itself gives it 80 s).
KillMode=mixed
TimeoutStopSec=100
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
