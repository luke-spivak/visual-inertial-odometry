<?xml version='1.0'?>
<sdf version='1.9'>
  <!--
    iris_with_ardupilot plus a rigidly-mounted VIO camera and IMU.

    Based on iris_with_ardupilot rather than iris_with_standoffs because the
    ArduPilot plugin, lift-drag and rotor force plugins live here -- a model
    built on standoffs alone parses and loads but cannot fly.

    Deliberately NOT iris_with_gimbal: VIO assumes a FIXED camera-IMU
    extrinsic, and a gimbal moves the camera relative to the body.

    The VIO IMU is separate from iris_with_standoffs' imu_sensor, which feeds
    ArduPilot SITL. Mirrors the hardware, where the ISM330DHCX sits on the Pi
    beside the camera rather than on the flight controller.
  -->
  <model name="iris_with_vio">
    <include>
      <uri>model://iris_with_standoffs</uri>
    </include>

    <!--
      visual markers for debugging
      - blade root    - teal
      - blade tip     - orange
      - blade cp      - yellow
      - blade forward - red
      - blade upward  - blue
    -->
